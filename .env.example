# Copy to .env (git-ignored). Exported shell variables take precedence, and
# <upstream>/.env (third_party/TheVirtualBiotech/.env) is read after this file.
# A blank value ("") means "unset": the configured default is used.
#
# Secrets in this file are never passed to agent Bash commands or MCP servers
# (except NCBI_API_KEY/NCBI_EMAIL, which only the PubMed server receives).

# Model provider key (required for live runs; checked before any session starts).
ANTHROPIC_API_KEY=""
# Open Targets Platform 25.09 parquet release (required for most data tools):
#   python third_party/TheVirtualBiotech/tools/download_open_targets.py /data/open_targets --workers 8
OPEN_TARGETS_DATA_PATH=""
# Optional: prepared Tahoe-100M pseudobulk DE (third_party/TheVirtualBiotech/docs/TAHOE_SETUP.md)
TAHOE_DATA_PATH=""
# Optional: directory with extra datasets agents may read (Tabula Sapiens h5ad, GEO, Visium, ...).
# Blank -> ./data
VBT_DATA_DIR=""
# Optional: interpreter for the MCP data servers. Blank -> vars.mcp_python's default
# in configs/default.yaml (the interpreter running vbt).
# Point it at the conda env from environment.yml if vbt runs elsewhere, e.g.
#   VBT_MCP_PYTHON="$HOME/miniforge3/envs/vbt-harness/bin/python"
VBT_MCP_PYTHON=""
# Optional: NCBI E-utilities key/email for the PubMed server (higher rate limits)
NCBI_API_KEY=""
NCBI_EMAIL=""
