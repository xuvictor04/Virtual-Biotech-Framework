# Copy to .env (git-ignored). Exported shell variables take precedence, and
# <upstream>/.env (third_party/TheVirtualBiotech/.env) is read after this file.
# A blank value ("") means "unset": the configured default is used.
#
# Secrets in this file are never passed to agent Bash commands or MCP servers
# (except NCBI_API_KEY/NCBI_EMAIL, which only the PubMed server receives).

# ---- Model: local open-weight model (the default; configs/default.yaml)
# OpenAI-compatible inference server (vLLM / SGLang / llama.cpp). Blank -> http://localhost:8000/v1
# Start one with `vbt local serve --profile h100` (see deploy/local/README.md).
VBT_LLM_BASE_URL=""
# Only if the server was started with --api-key (vLLM) / an auth proxy. Blank -> no key.
# (OPENAI_API_KEY is never sent to the local server.)
VBT_LLM_API_KEY=""
# The server's --data-parallel-size, when it differs from the harness profile's default
# (1; local-dp / local-deepseek-v4: 4). `vbt local serve` prints the value to export.
VBT_LLM_DP_SIZE=""
# Hugging Face token for gated checkpoints when the server downloads weights (not needed for
# Qwen3.8 or DeepSeek-V4; read by vLLM / the docker compose services, not by the harness).
HF_TOKEN=""

# ---- Model: Claude instead (`vbt --profile claude ...` or `--profile paper`)
# Required only for the Anthropic provider; checked before any session starts.
ANTHROPIC_API_KEY=""

# ---- Web search for the local model (docs/WEB_SEARCH.md). Claude uses its native search.
# Self-hosted SearxNG: docker compose -f deploy/local/docker-compose.yml up -d searxng
# Blank -> http://localhost:8888 (configs/default.yaml web.search.searxng_url)
SEARXNG_URL=""
# Optional alternative: Brave Search API key (used with web.search.backend: brave; the shipped
# configs always configure a SearxNG URL, so `auto` picks SearxNG).
BRAVE_SEARCH_API_KEY=""

# ---- Reference data
# Open Targets Platform 25.09 parquet release (required for most data tools):
#   python third_party/TheVirtualBiotech/tools/download_open_targets.py /data/open_targets --workers 8
OPEN_TARGETS_DATA_PATH=""
# Optional: prepared Tahoe-100M pseudobulk DE (third_party/TheVirtualBiotech/docs/TAHOE_SETUP.md)
TAHOE_DATA_PATH=""
# Optional: directory with extra datasets agents may read (Tabula Sapiens h5ad, GEO, Visium, ...).
# Blank -> ./data
VBT_DATA_DIR=""
# Optional: interpreter for the MCP data servers. Blank -> vars.mcp_python's default
# in configs/default.yaml (the interpreter running vbt).
# Point it at the conda env from environment.yml if vbt runs elsewhere, e.g.
#   VBT_MCP_PYTHON="$HOME/miniforge3/envs/vbt-harness/bin/python"
VBT_MCP_PYTHON=""
# Optional: NCBI E-utilities key/email for the PubMed server (higher rate limits)
NCBI_API_KEY=""
NCBI_EMAIL=""
# Optional: location of the upstream checkout (default: third_party/TheVirtualBiotech).
VBT_UPSTREAM=""
# Required for `vbt web` unless --no-auth on localhost: the browser login password.
VBT_WEB_PASSWORD=""
